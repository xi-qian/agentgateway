# AgentGateway Environment Variables
# Copy to .env and edit before deploying

# ---- Gateway ----
# GW_HOST=0.0.0.0
# GW_PORT=8900
# GW_MANAGER_URL=http://manager:8800
# GW_ADAPTERS_CONFIG={"mock":{"enabled":true}}

# For Feishu:
# GW_ADAPTERS_CONFIG={"feishu":{"app_id":"cli_xxx","app_secret":"xxx"}}
# For DingTalk:
# GW_ADAPTERS_CONFIG={"dingtalk":{"client_id":"xxx","client_secret":"xxx"}}
# For WeCom:
# GW_ADAPTERS_CONFIG={"wecom":{"bot_id":"xxx","secret":"xxx"}}

# ---- Manager ----
# MG_HOST=0.0.0.0
# MG_PORT=8800
# MG_DB_PATH=/data/manager.db
# MG_IDLE_TIMEOUT=1800
# MG_HEALTH_TIMEOUT=90

# ---- Daemon ----
DA_MANAGER_URL=ws://manager:8800/ws
DA_SERVER_ID=server-1
DA_GATEWAY_URL=ws://gateway:8900/ws

# Hermes Agent installation source (optional)
# DA_HERMES_PIP_SOURCE=git+https://github.com/user/hermes-agent.git
# DA_HERMES_PIP_SOURCE=/hermes  # local path mounted as volume

# ---- Agent (AI) ----
ANTHROPIC_API_KEY=
